{
	"name": "kaede",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"apis": "bun run --cwd packages/apis dev",
		"dev": "bun run --cwd packages/bot dev",
		"start": "bun run --cwd packages/bot start",
		"site:dev": "bun run --cwd packages/site dev",
		"site": "bun run --cwd packages/site preview",
		"site:build": "bun run --cwd packages/site build",
		"build": "bun run site:build",
		"check": "biome check ."
	},
	"devDependencies": {
		"@types/bun": "1.3.14"
	},
	"dependencies": {
		"arktype": "2.2.0",
		"arkenv": "0.11.0"
	},
	"trustedDependencies": [
		"sagiri"
	]
}
